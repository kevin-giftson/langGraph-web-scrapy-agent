# Copy this file to .env and fill in your key (free at https://console.groq.com/keys)
GROQ_API_KEY=

# Optional overrides — run `python check_setup.py` to see which models your key can use
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# Offline mode (install Ollama, then: ollama pull gemma3:4b)
OLLAMA_HOST=http://localhost:11434
OLLAMA_VISION_MODEL=gemma3:4b
OLLAMA_TEXT_MODEL=gemma3:4b
